---
import { SITE_TITLE, URL_PREFIX } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={URL_PREFIX}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={`${URL_PREFIX}/`}>Home</HeaderLink>
			<HeaderLink href={`${URL_PREFIX}/people`}>People</HeaderLink>
			<HeaderLink href={`${URL_PREFIX}/events`}>Events</HeaderLink>
			<HeaderLink href={`${URL_PREFIX}/categories`}>Browse</HeaderLink>
			<HeaderLink href={`${URL_PREFIX}/about`}>About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgba(255,255,255,0.95);
		box-shadow: 0 2px 12px rgba(35, 55, 34, 0.08);
		backdrop-filter: blur(8px);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 600;
	}
	nav a.active {
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
			padding: 0.75rem 0;
		}
		.internal-links {
			gap: 0.1rem;
		}
	}
</style>
