---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, URL_PREFIX } from '../consts';

const people = (await getCollection('people')).slice(0, 3);
const events = (await getCollection('events')).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Local sharing, growing, and making</p>
				<h1>Stone Creek Exchange brings neighbors together around plants, projects, and skills.</h1>
				<p>What begins with Lapis Place Nursery expands into a welcoming place to discover nearby gardeners, makers, teachers, and community events.</p>
				<div>
					<a class="button" href={`${URL_PREFIX}/people/lapis-place-nursery`}>Visit Lapis Place Nursery</a>
					<a class="button secondary" href={`${URL_PREFIX}/events`}>See upcoming events</a>
				</div>
			</section>

			<section class="grid">
				<div class="card">
					<h2>Neighbors</h2>
					<div class="list">
						{people.map((person) => {
							const slug = person.id.replace(/\.md$/, '');
							return <a href={`{URL_PREFIX}/people/${slug}`}>{person.data.title}</a>;
						})}
					</div>
				</div>
				<div class="card">
					<h2>Events</h2>
					<div class="list">
						{events.map((event) => {
							const slug = event.id.replace(/\.md$/, '');
							return <a href={`{URL_PREFIX}/events/${slug}`}>{event.data.title}</a>;
						})}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
