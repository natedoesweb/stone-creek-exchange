---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <BaseHead title="Browse categories" description="Explore the community by category such as gardening, trades, crafts, and education." />
  </head>
  <body>
    <Header />
    <main class="page">
      <section class="card">
        <p class="eyebrow">Browse by category</p>
        <h1>Ways to explore the exchange</h1>
        <div class="list">
          <a href="/people">Gardening & Growing</a>
          <a href="/people">Trades & Building</a>
          <a href="/people">Crafts & Making</a>
          <a href="/people">Food & Cooking</a>
          <a href="/people">Art & Photography</a>
          <a href="/people">Outdoor Activities</a>
          <a href="/people">Education & Skills</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
