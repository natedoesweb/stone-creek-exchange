---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<html lang="en">
  <head>
    <BaseHead title={entry.data.title} description={entry.data.summary} />
  </head>
  <body>
    <Header />
    <main class="page">
      <article class="card">
        <p class="eyebrow">{entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        <p class="meta">{entry.data.location}</p>
        <p class="meta">{entry.data.date}</p>
        <div class="content">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
